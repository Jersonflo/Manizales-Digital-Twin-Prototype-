[node name="GobernaciónDeCaldas" type="Sprite2D" parent="Mundo/Hitos"]
position = Vector2(758, 726)
texture = ExtResource("gobernacion")
offset = Vector2(0, -21.0)
metadata/nombre = "Gobernación de Caldas"
metadata/tipo = "Edificio patrimonial"
metadata/info = "Palacio de estilo republicano frente a la Plaza de Bolívar, sede del gobierno departamental. Se construyó en la segunda mitad de la década de 1920, tras los incendios que arrasaron el centro."
metadata/fuente = "Radio Nacional de Colombia; guías de patrimonio de Manizales"

