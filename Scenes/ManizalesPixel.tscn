[node name="MonumentoALosColonizadores" type="Sprite2D" parent="Mundo/Hitos"]
position = Vector2(577, 521)
texture = ExtResource("colonizadores")
offset = Vector2(0, -20.0)
metadata/nombre = "Monumento a los Colonizadores"
metadata/tipo = "Monumento"
metadata/info = "Obra del artista manizaleño Luis Guillermo Vallejo, construida entre 1997 y 2002 en el alto de Chipre. Tiene unas 50 toneladas de bronce, en parte donado por los manizaleños en llaves y otros objetos, y rinde homenaje a la colonización antioqueña."
metadata/fuente = "Radio Nacional de Colombia; Lonely Planet"

