[node name="CatedralBasílica" type="Sprite2D" parent="Mundo/Hitos"]
position = Vector2(758, 799)
texture = ExtResource("catedral")
offset = Vector2(0, -42.0)
metadata/nombre = "Catedral Basílica"
metadata/tipo = "Templo"
metadata/info = "Catedral neogótica levantada en concreto para resistir incendios y sismos. La diseñó el arquitecto francés Julien Polti; las obras empezaron en 1928 y se consagró en 1939. Su aguja central supera los 100 m y es la iglesia más alta de Colombia. En el sismo de agosto de 2026 la torre principal colapsó en parte."
metadata/fuente = "Radio Nacional de Colombia; Forbes Argentina (ago. 2026)"

