texture = ExtResource("ecoparque")
offset = Vector2(0, -16.0)
metadata/nombre = "Ecoparque Alcázares"
metadata/tipo = "Ecoparque"
metadata/info = "Primer ecoparque urbano de Manizales, creado para proteger las laderas de Chipre y Alcázares. Ofrece senderos, recorridos guiados y avistamiento de aves; hace parte de la Red de Ecoparques."
metadata/fuente = "Boletín ambiental IDEA – U. Nacional sede Manizales"

