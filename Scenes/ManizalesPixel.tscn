[node name="TorreDeHerveoElCable" type="Sprite2D" parent="Mundo/Hitos"]
position = Vector2(1398, 1087)
texture = ExtResource("torre_cable")
offset = Vector2(0, -31.0)
metadata/nombre = "Torre de Herveo · El Cable"
metadata/tipo = "Monumento nacional"
metadata/info = "Torre de madera del antiguo Cable Aéreo Manizales–Mariquita, terminado en 1922. Se hizo en madera porque el barco que traía la torre de acero desde Inglaterra fue hundido por un submarino alemán. Hoy es monumento nacional en el sector de El Cable."
metadata/fuente = "Wikipedia; Radio Nacional de Colombia"

