[node name="TorreAlCielo" type="Sprite2D" parent="Mundo/Hitos"]
position = Vector2(546, 610)
texture = ExtResource("torre_chipre")
offset = Vector2(0, -32.0)
metadata/nombre = "Torre al Cielo"
metadata/tipo = "Mirador"
metadata/info = "Mirador de unos 30 m en el barrio Chipre, inaugurado en 2008 sobre un antiguo tanque de agua. Tiene una pasarela exterior (Sky Walk) con vista de 360° sobre la ciudad y los nevados."
metadata/fuente = "Blu Radio; Lonely Planet"

