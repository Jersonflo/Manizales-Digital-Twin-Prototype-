texture = ExtResource("bolivar")
offset = Vector2(0, -14.0)
metadata/nombre = "Plaza de Bolívar"
metadata/tipo = "Plaza"
metadata/info = "Corazón del centro histórico, entre la Catedral y la Gobernación. Su escultura Bolívar Cóndor, del maestro Rodrigo Arenas Betancourt, se inauguró en 1991 y muestra al Libertador convertido en cóndor."
metadata/fuente = "Lonely Planet; Wanderlog"

